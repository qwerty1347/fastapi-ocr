# APP
APP_NAME=fastapi-ocr
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:9093

# NOTEBOOK
JUPYTER_TOKEN=

# MySQL
DB_CONNECTION=mysql
DB_HOST=fastapi_ocr-mysql
DB_PORT=3306
DB_DATABASE=fastapi
DB_USERNAME=root
DB_PASSWORD=root

# MongoDB
MONGO_DB_CONNECTION=mongodb
MONGO_DB_HOST=fastapi_ocr-mongodb
MONGO_DB_PORT=27017
MONGO_DB_DATABASE=laravel8-admin
MONGO_DB_USERNAME=admin
MONGO_DB_PASSWORD=admin
MONGO_DB_AUTH_DATABASE=admin

CELERY_BROKER_URL="redis://fastapi_ocr-redis:6379/0"
CELERY_RESULT_BACKEND="redis://fastapi_ocr-redis:6379/1"

# PATH
STORAGE_PATH=storage

# JWT
JWT_EXPIRE_MINUTES=1440
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_SUBJECT=

# OCR
CLOVA_OCR_SECRET_KEY=
CLOVA_OCR_APIGW_INVOKE_URL=